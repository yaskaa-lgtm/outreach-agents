# =============================================================================
# Copy this file to `.env` and adapt it:   cp .env.example .env
#   (Windows PowerShell:                   Copy-Item .env.example .env)
# `.env` is ignored by Git. NEVER put a real key in this file: it is public.
# Every value below is a FAKE placeholder or a local-development default.
# =============================================================================

# --- Mode (safe defaults) -----------------------------------------------------
# DEMO_MODE=true  -> fake LLM + fake data, no API key needed, emails go to Mailpit.
# DRY_RUN=true    -> real APIs, but every email is captured by Mailpit.
# Real sending needs DEMO_MODE=false, DRY_RUN=false AND a confirmation in the UI.
DEMO_MODE=true
DRY_RUN=true
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose) ----------------------------------------------
# Local-only credentials: the database port is bound to 127.0.0.1.
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_dev_password
POSTGRES_DB=outreach
# Used when you run the API or worker on your machine (`uv run ...`).
# Inside docker compose the host is `db`: compose builds that URL itself.
# 127.0.0.1 rather than localhost: faster on Windows (no IPv6 attempt first).
DATABASE_URL=postgresql+psycopg://outreach:outreach_dev_password@127.0.0.1:5432/outreach

# --- HTTP API -----------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Web app (server side) ----------------------------------------------------
# URL the Next.js server uses to reach the API (compose uses http://api:8000).
API_INTERNAL_URL=http://127.0.0.1:8000
# URLs of the links shown to your browser.
API_PUBLIC_URL=http://localhost:8000
MAILPIT_UI_URL=http://localhost:8025

# --- Mailpit: local SMTP server that captures emails (UI: http://localhost:8025)
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# --- LLM: Anthropic -----------------------------------------------------------
# Model IDs checked on 2026-09-30:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL_REASONING=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-4-5

# --- Data providers -----------------------------------------------------------
HUNTER_API_KEY=xxxxxxxx

# --- Encryption at rest (SMTP/IMAP credentials) -------------------------------
# Generate a real key with:
#   uv run python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=xxxxxxxx

# --- Worker -------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
