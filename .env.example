# =============================================================================
# Copy this file to `.env` and adapt it:   cp .env.example .env
#   (Windows PowerShell:                   Copy-Item .env.example .env)
# `.env` is ignored by Git. NEVER put a real key in this file: it is public.
# Every value below is a FAKE placeholder or a local-development default.
# =============================================================================

# --- Mode (safe defaults) -----------------------------------------------------
# DEMO_MODE=true  -> fake LLM + fake data, no API key needed, emails go to Mailpit.
# DRY_RUN=true    -> real APIs, but every email is captured by Mailpit.
# Real sending needs DEMO_MODE=false, DRY_RUN=false AND a confirmation in the UI.
DEMO_MODE=true
DRY_RUN=true
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose) ----------------------------------------------
# Local-only credentials: the database port is bound to 127.0.0.1.
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_dev_password
POSTGRES_DB=outreach
# Used when you run the API or worker on your machine (`uv run ...`).
# Inside docker compose the host is `db`: compose builds that URL itself.
# 127.0.0.1 rather than localhost: faster on Windows (no IPv6 attempt first).
DATABASE_URL=postgresql+psycopg://outreach:outreach_dev_password@127.0.0.1:5432/outreach

# --- HTTP API -----------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_RATE_LIMIT_PER_MINUTE=300

# --- Authentication (single admin account) ------------------------------------
# Created at first start when DEMO_MODE=false. Password: at least 12 characters.
# In DEMO_MODE the demo account is used instead (see README).
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_COOKIE_NAME=oa_session
# Keep true. Browsers accept Secure cookies on http://localhost; set false only if your
# browser refuses to log you in over plain http on your own machine.
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Web app (server side) ----------------------------------------------------
# URL the Next.js server uses to reach the API (compose uses http://api:8000).
API_INTERNAL_URL=http://127.0.0.1:8000
# URLs of the links shown to your browser.
API_PUBLIC_URL=http://localhost:8000
MAILPIT_UI_URL=http://localhost:8025

# --- Mailpit: local SMTP server that captures emails (UI: http://localhost:8025)
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# --- LLM: Anthropic -----------------------------------------------------------
# Model IDs checked on 2026-09-30:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL_REASONING=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-4-5
# Reasoning depth of the reasoning model: low | medium | high | xhigh | max (empty = API default).
LLM_EFFORT_REASONING=medium
LLM_MAX_OUTPUT_TOKENS=16000
# Prices in USD per million tokens, copied from the same page on 2026-09-30.
# Update them whenever you change a model above.
LLM_PRICE_REASONING_INPUT_USD_PER_MTOK=2
LLM_PRICE_REASONING_OUTPUT_USD_PER_MTOK=10
LLM_PRICE_FAST_INPUT_USD_PER_MTOK=1
LLM_PRICE_FAST_OUTPUT_USD_PER_MTOK=5
# 1 USD in EUR. Updated 2026-09-30 from the ECB reference rate of 2026-09-29
# (1 EUR = 1.1355 USD): https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html
USD_TO_EUR_RATE=0.8807
# Budget of a new workspace, in euros per day (editable later in the app).
# 80 %: warning in the UI. 100 %: LLM work paused until tomorrow or a budget increase.
# Also set a spend limit in the Anthropic Console as a second safety net.
DAILY_LLM_BUDGET_EUR=2

# --- Web reading (polite bot, SSRF-protected) -----------------------------------
BOT_USER_AGENT="outreach-agents-bot/0.1 (+https://github.com/yaskaa-lgtm/outreach-agents)"
BOT_ROBOTS_NAME=outreach-agents-bot
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
FETCH_MIN_INTERVAL_PER_HOST_SECONDS=1
OFFER_ANALYSIS_MAX_PAGES=6

# --- Data providers -----------------------------------------------------------
HUNTER_API_KEY=xxxxxxxx

# --- Encryption at rest (SMTP/IMAP credentials) -------------------------------
# Generate a real key with:
#   uv run python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=xxxxxxxx

# --- Worker -------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
