{
  "components": {
    "schemas": {
      "AnalyzeOfferRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "website_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website Url"
          }
        },
        "title": "AnalyzeOfferRequest",
        "type": "object"
      },
      "BudgetStatus": {
        "properties": {
          "limit_eur": {
            "title": "Limit Eur",
            "type": "number"
          },
          "ratio": {
            "title": "Ratio",
            "type": "number"
          },
          "resets_at": {
            "format": "date-time",
            "title": "Resets At",
            "type": "string"
          },
          "spent_eur": {
            "title": "Spent Eur",
            "type": "number"
          },
          "state": {
            "enum": [
              "ok",
              "warning",
              "exhausted"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "spent_eur",
          "limit_eur",
          "ratio",
          "state",
          "resets_at"
        ],
        "title": "BudgetStatus",
        "type": "object"
      },
      "BudgetUpdate": {
        "additionalProperties": false,
        "properties": {
          "daily_limit_eur": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "title": "Daily Limit Eur",
            "type": "number"
          }
        },
        "required": [
          "daily_limit_eur"
        ],
        "title": "BudgetUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/RunMode"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "mode",
          "database",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OfferProfileData": {
        "additionalProperties": false,
        "description": "Output of Agent 1. Lists may be empty: never fill gaps with guesses.",
        "properties": {
          "company_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company Name"
          },
          "competitors_mentioned": {
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 10,
            "title": "Competitors Mentioned",
            "type": "array"
          },
          "differentiators": {
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 10,
            "title": "Differentiators",
            "type": "array"
          },
          "geography": {
            "description": "Where they operate.",
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 5,
            "title": "Geography",
            "type": "array"
          },
          "missing_information": {
            "description": "Important facts that the sources do not contain.",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Missing Information",
            "type": "array"
          },
          "offerings": {
            "description": "Products or services.",
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 10,
            "title": "Offerings",
            "type": "array"
          },
          "pricing": {
            "description": "Only if prices are public.",
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 5,
            "title": "Pricing",
            "type": "array"
          },
          "proof_points": {
            "description": "Named customers, figures, certifications, awards.",
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 10,
            "title": "Proof Points",
            "type": "array"
          },
          "summary": {
            "description": "Two or three sentences: what the company sells and to whom.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "target_customers": {
            "items": {
              "$ref": "#/components/schemas/SourcedClaim"
            },
            "maxItems": 10,
            "title": "Target Customers",
            "type": "array"
          },
          "value_proposition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourcedClaim"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "company_name",
          "summary",
          "offerings",
          "target_customers",
          "value_proposition",
          "differentiators",
          "pricing",
          "geography",
          "proof_points",
          "competitors_mentioned",
          "missing_information"
        ],
        "title": "OfferProfileData",
        "type": "object"
      },
      "OfferProfileRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/OfferProfileData"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "pages_fetched": {
            "items": {
              "type": "string"
            },
            "title": "Pages Fetched",
            "type": "array"
          },
          "source_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Description"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "status": {
            "enum": [
              "draft",
              "validated"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "validated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validated At"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "status",
          "source_url",
          "source_description",
          "data",
          "warnings",
          "pages_fetched",
          "created_at",
          "updated_at",
          "validated_at"
        ],
        "title": "OfferProfileRead",
        "type": "object"
      },
      "OfferProfileUpdate": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OfferProfileData"
          }
        },
        "required": [
          "data"
        ],
        "title": "OfferProfileUpdate",
        "type": "object"
      },
      "RunMode": {
        "description": "What the application is allowed to do with emails.\n\n- DEMO: fake LLM, fake data providers, emails captured by Mailpit. No API key needed.\n- DRY_RUN: real LLM and data providers, but every email is captured by Mailpit.\n- LIVE: emails really leave. Requires DRY_RUN=false *and* a confirmation in the UI.",
        "enum": [
          "DEMO",
          "DRY_RUN",
          "LIVE"
        ],
        "title": "RunMode",
        "type": "string"
      },
      "SegmentCriteria": {
        "additionalProperties": false,
        "properties": {
          "departements": {
            "description": "French département codes ('75', '2A'); empty = all France.",
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Departements",
            "type": "array"
          },
          "headcount_ranges": {
            "description": "INSEE 'tranche d'effectif salarié' codes.",
            "items": {
              "enum": [
                "NN",
                "00",
                "01",
                "02",
                "03",
                "11",
                "12",
                "21",
                "22",
                "31",
                "32",
                "41",
                "42",
                "51",
                "52",
                "53"
              ],
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Headcount Ranges",
            "type": "array"
          },
          "keywords": {
            "description": "Short search keywords.",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Keywords",
            "type": "array"
          },
          "naf_codes": {
            "description": "NAF rév. 2 sub-class codes, format '62.01Z'.",
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "minItems": 1,
            "title": "Naf Codes",
            "type": "array"
          }
        },
        "required": [
          "naf_codes",
          "headcount_ranges",
          "departements",
          "keywords"
        ],
        "title": "SegmentCriteria",
        "type": "object"
      },
      "SegmentRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "criteria": {
            "$ref": "#/components/schemas/SegmentCriteria"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "fit_rationale": {
            "title": "Fit Rationale",
            "type": "string"
          },
          "fit_score": {
            "title": "Fit Score",
            "type": "integer"
          },
          "hook_angle": {
            "title": "Hook Angle",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "main_pain": {
            "title": "Main Pain",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offer_profile_id": {
            "format": "uuid",
            "title": "Offer Profile Id",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "selected": {
            "title": "Selected",
            "type": "boolean"
          },
          "target_titles": {
            "items": {
              "type": "string"
            },
            "title": "Target Titles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "offer_profile_id",
          "position",
          "name",
          "description",
          "criteria",
          "target_titles",
          "main_pain",
          "hook_angle",
          "fit_score",
          "fit_rationale",
          "selected",
          "created_at"
        ],
        "title": "SegmentRead",
        "type": "object"
      },
      "SegmentSelection": {
        "additionalProperties": false,
        "properties": {
          "selected": {
            "title": "Selected",
            "type": "boolean"
          }
        },
        "required": [
          "selected"
        ],
        "title": "SegmentSelection",
        "type": "object"
      },
      "SourcedClaim": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "description": "One factual statement.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Claim",
            "type": "string"
          },
          "excerpt": {
            "description": "Exact sentence or phrase copied from that source, supporting the claim.",
            "maxLength": 400,
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "source_url": {
            "description": "URL of a page you fetched that supports the claim, or 'user-input:description' if it comes from the user's description.",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "claim",
          "source_url",
          "excerpt"
        ],
        "title": "SourcedClaim",
        "type": "object"
      },
      "UserRead": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "is_demo": {
            "title": "Is Demo",
            "type": "boolean"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "role",
          "is_demo"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "outreach-agents API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/budget": {
      "get": {
        "operationId": "get_budget_budget_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Budget",
        "tags": [
          "budget"
        ]
      },
      "put": {
        "operationId": "update_budget_budget_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BudgetUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Budget",
        "tags": [
          "budget"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/offer-profiles/analyze": {
      "post": {
        "description": "Runs Agent 1 (offer analyst). Can take up to a few minutes with a real LLM.",
        "operationId": "analyze_offer_profiles_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeOfferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferProfileRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze",
        "tags": [
          "offer profiles"
        ]
      }
    },
    "/offer-profiles/current": {
      "get": {
        "operationId": "current_profile_offer_profiles_current_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferProfileRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Current Profile",
        "tags": [
          "offer profiles"
        ]
      }
    },
    "/offer-profiles/{profile_id}": {
      "put": {
        "operationId": "update_offer_profiles__profile_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Profile Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferProfileRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update",
        "tags": [
          "offer profiles"
        ]
      }
    },
    "/offer-profiles/{profile_id}/segments": {
      "get": {
        "operationId": "list_segments_offer_profiles__profile_id__segments_get",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Profile Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SegmentRead"
                  },
                  "title": "Response List Segments Offer Profiles  Profile Id  Segments Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Segments",
        "tags": [
          "offer profiles"
        ]
      },
      "post": {
        "description": "Runs Agent 2 (ICP strategist) on a validated profile; replaces previous segments.",
        "operationId": "generate_segments_offer_profiles__profile_id__segments_post",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Profile Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SegmentRead"
                  },
                  "title": "Response Generate Segments Offer Profiles  Profile Id  Segments Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Segments",
        "tags": [
          "offer profiles"
        ]
      }
    },
    "/offer-profiles/{profile_id}/validate": {
      "post": {
        "operationId": "validate_offer_profiles__profile_id__validate_post",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Profile Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferProfileRead"
                }
              }
            },
